# Copy manually to ignored .env. Provider keys are optional; HTTP owner auth is required.
WRITER_API_HOST=127.0.0.1
WRITER_API_PORT=8791
WRITER_WEB_HOST=127.0.0.1
WRITER_WEB_PORT=5174
WRITER_WEB_DIST=apps/web/dist
RUST_LOG=metrix_writer_api=info,tower_http=info

# Generate outside source: metrix-writer-api --init-owner-key <private-file>
# Then set its absolute path. Never put the key itself here or in VITE_*.
# WRITER_OWNER_KEY_FILE=/absolute/private/path/owner-key
# pnpm dev defaults to its Vite origin; built API defaults to its loopback URL.
# Network access requires HTTPS at a trusted proxy preserving the public Host.
# WRITER_HTTP_ORIGIN=https://writer.example.com

# Private disk storage; default is $HOME/.local/share/metrix-writer.
# Each simultaneous API instance requires a different directory.
# WRITER_DATA_DIR=/absolute/private/path/metrix-writer
WRITER_MAX_UPLOAD_BYTES=1073741824
# Aggregate/device storage, queue and processing concurrency:
# docs/security/api-resource-limits.md lists all settings and defaults.
# WRITER_STORAGE_BYTES=21474836480
# WRITER_DEVICE_STORAGE_BYTES=5368709120
# WRITER_UPLOAD_IDLE_SECONDS=30
# WRITER_MAX_PENDING_JOBS=32
# WRITER_DEVICE_MAX_PENDING_JOBS=8

# Server-only credentials. Never use VITE_ for secrets.
# Configured cloud adapters allow a first unverified transcription attempt.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional operator-managed whisper.cpp; no model download occurs automatically.
# See docs/features/local-transcription.md for GPU/runtime and model setup.
# WRITER_LOCAL_STT_URL=http://127.0.0.1:8178/inference
# WRITER_LOCAL_STT_MODEL=whisper-tiny
# WRITER_LOCAL_STT_MODEL_PATH=/absolute/private/path/ggml-tiny.bin
# WRITER_LOCAL_STT_FFMPEG=/usr/bin/ffmpeg
# WRITER_LOCAL_STT_TIMEOUT_SECONDS=300
# WRITER_LOCAL_STT_MAX_AUDIO_BYTES=67108864
