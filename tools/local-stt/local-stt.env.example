# Server settings only. Copy to an ignored environment file and replace paths.
# The service must be pinned to this model and verified to use Vulkan at startup.
WRITER_LOCAL_STT_URL=http://127.0.0.1:8179/inference
WRITER_LOCAL_STT_MODEL=ivrit-turbo
WRITER_LOCAL_STT_MODEL_PATH=/absolute/api-readable/path/to/ivrit-turbo.bin
WRITER_LOCAL_STT_FFMPEG=/usr/bin/ffmpeg
WRITER_LOCAL_STT_TIMEOUT_SECONDS=300
WRITER_LOCAL_STT_MAX_AUDIO_BYTES=67108864
